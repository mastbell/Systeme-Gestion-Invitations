# Base de données — SQLite par défaut (aucune installation requise).
# En production, remplacer par une URL PostgreSQL, ex:
# DATABASE_URL=postgresql://user:password@localhost:5432/invitations_db
DATABASE_URL=sqlite:///./invitations.db

# Twilio (WhatsApp / SMS) — laisser vide pour tester en mode simulation
# (les envois sont journalisés dans la console au lieu d'être réellement envoyés)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# URL publique du serveur (utilisée dans les liens envoyés par WhatsApp/SMS)
URL_PUBLIQUE=http://localhost:8000
